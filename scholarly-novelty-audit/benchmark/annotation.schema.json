{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noveltyaudit.dev/schemas/v0.3.2/benchmark-annotation.schema.json",
  "x-schema-version": "0.3.2",
  "title": "Reviewer-grounded NoveltyAudit Benchmark Case",
  "type": "object",
  "required": ["case_id", "source_dataset_id", "source_license", "cutoff", "claim_map", "gold_prior_set", "reviewer_evidence", "annotation_provenance"],
  "properties": {
    "case_id": {"type": "string"},
    "source_dataset_id": {"type": "string"},
    "source_license": {"type": "string"},
    "cutoff": {"type": "string", "format": "date"},
    "claim_map": {"type": "object"},
    "gold_prior_set": {"type": "array", "items": {"type": "string"}},
    "gold_coverage": {"type": "object"},
    "gold_bridges": {"type": "array"},
    "reviewer_evidence": {"type": "array"},
    "not_in_supplied_bibliography": {"type": "array", "items": {"type": "string"}},
    "annotation_provenance": {"type": "object"},
    "annotator_agreement": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  }
}
