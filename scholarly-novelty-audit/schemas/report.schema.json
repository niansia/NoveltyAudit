{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noveltyaudit.dev/schemas/v0.3.1/report.schema.json",
  "x-schema-version": "0.3.1",
  "title": "NoveltyAudit Report",
  "type": "object",
  "required": ["schema_version", "audit_id", "generated_at", "candidate_ids", "run_manifest", "input", "author_bibliography", "claim_map", "verdict", "papers", "fulltext_acquisitions", "evidence", "top_killers", "minimal_prior_sets", "bridges", "landscape_bridges", "criticality_sensitivity", "ancestor_terms", "residual_novelty", "defensible_rewrite", "search", "excluded", "audit_log"],
  "properties": {
    "schema_version": {"const": "0.3.1"},
    "audit_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "minItems": 1},
    "run_manifest": {
      "type": "object",
      "required": ["tool_version", "config_hash", "cutoff", "domain", "model_name", "prompt_version", "retrieval_started_at", "retrieval_completed_at", "candidate_snapshot_hash", "provider_endpoints"],
      "properties": {
        "tool_version": {"const": "0.3.1"},
        "config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "cutoff": {"type": "string", "format": "date"},
        "domain": {"type": "string", "minLength": 1},
        "model_name": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "retrieval_started_at": {"type": "string", "format": "date-time"},
        "retrieval_completed_at": {"type": "string", "format": "date-time"},
        "candidate_snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "provider_endpoints": {"type": "array", "items": {"type": "object", "required": ["name", "endpoint", "version"]}}
      }
    },
    "input": {
      "type": "object",
      "required": ["claim", "normalized_claim", "cutoff", "strict_date"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "normalized_claim": {"type": "string", "minLength": 1},
        "field": {"type": "string"},
        "cutoff": {"type": "string", "format": "date"},
        "strict_date": {"type": "boolean"}
      }
    },
    "author_bibliography": {
      "type": "object",
      "required": ["status", "source", "entries", "normalized_paper_ids", "unmatched_entries"],
      "properties": {
        "status": {"enum": ["PROVIDED", "NOT_PROVIDED"]},
        "source": {"type": "string"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["raw_entry", "matched_paper_id", "match_basis"],
            "properties": {
              "raw_entry": {"type": "string", "minLength": 1},
              "matched_paper_id": {"type": ["string", "null"]},
              "match_basis": {"enum": ["DOI", "ARXIV_ID", "TITLE_AUTHOR", "MANUAL", "NONE"]}
            }
          }
        },
        "normalized_paper_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unmatched_entries": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claim_map": {"$ref": "claim.schema.json"},
    "verdict": {
      "type": "object",
      "required": ["classification", "novelty_risk", "search_coverage", "evidence_confidence", "main_concern", "evidence_ids", "decided_at"],
      "properties": {
        "classification": {"enum": ["DIRECT_PRECEDENT", "STRONG_COMPOSITION_RISK", "PLAUSIBLE_COMPOSITION_RISK", "FRAGMENTED_PRECEDENT", "RESIDUAL_NOVELTY", "INCONCLUSIVE"]},
        "novelty_risk": {"enum": ["HIGH", "MEDIUM", "LOW", "INCONCLUSIVE"]},
        "search_coverage": {"enum": ["BROAD", "MODERATE", "NARROW"]},
        "evidence_confidence": {"enum": ["STRONG", "MIXED", "WEAK"]},
        "decided_at": {"type": "string", "format": "date-time"},
        "main_concern": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "risk_basis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "detail"],
            "properties": {
              "type": {"enum": ["CRITICALITY_SENSITIVITY_COLLAPSE", "CRITICALITY_DISPUTE", "OTHER_EXPLICIT_RISK"]},
              "detail": {"type": "string", "minLength": 1},
              "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "papers": {"type": "array", "items": {"$ref": "paper.schema.json"}},
    "fulltext_acquisitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "paper_id", "status", "source_url", "source_kind", "retrieved_at", "content_sha256", "text_sha256", "text_path", "extraction_method", "char_count"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "paper_id": {"type": "string", "minLength": 1},
          "status": {"const": "COMPLETE"},
          "source_url": {"type": "string", "format": "uri"},
          "source_kind": {"enum": ["PDF", "HTML", "TEXT"]},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "text_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "text_path": {"type": "string", "minLength": 1},
          "extraction_method": {"enum": ["pypdf", "html.parser", "utf-8"]},
          "char_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "top_killers": {"type": "array", "items": {"type": "object", "required": ["paper_id", "covers", "does_not_cover", "evidence_ids", "bibliography_status"], "properties": {"paper_id": {"type": "string"}, "covers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "does_not_cover": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "bibliography_status": {"enum": ["IN_BIBLIOGRAPHY", "NOT_IN_BIBLIOGRAPHY", "BIBLIOGRAPHY_UNAVAILABLE"]}}}},
    "minimal_prior_sets": {"type": "array", "items": {"type": "object", "required": ["paper_ids", "size", "covered_facets", "evidence_ids"], "properties": {"paper_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 3, "uniqueItems": true}, "size": {"type": "integer", "minimum": 1, "maximum": 3}, "covered_facets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}},
    "bridges": {"type": "array", "items": {"type": "object", "required": ["type", "provenance_type", "paper_ids", "source_paper_id", "cutoff_status", "evidence_ids"], "properties": {"type": {"type": "string"}, "provenance_type": {"enum": ["graph", "text"]}, "paper_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true}, "source_paper_id": {"type": "string"}, "cutoff_status": {"enum": ["ELIGIBLE", "POST_CUTOFF", "DATE_UNCERTAIN"]}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "base_rate_status": {"enum": ["PASSED", "HIGH_BASE_RATE", "UNASSESSED", "NOT_APPLICABLE"]}}}},
    "landscape_bridges": {"type": "array", "items": {"type": "object", "required": ["type", "underlying_type", "provenance_type", "paper_ids", "source_paper_id", "cutoff_status", "graph_verified", "affects_historical_verdict"], "properties": {"type": {"const": "LANDSCAPE_BRIDGE"}, "underlying_type": {"enum": ["DIRECT_CITATION", "CO_CITATION", "SHARED_DESCENDANT"]}, "provenance_type": {"const": "graph"}, "paper_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true}, "source_paper_id": {"type": "string"}, "cutoff_status": {"enum": ["POST_CUTOFF", "DATE_UNCERTAIN"]}, "graph_verified": {"const": true}, "affects_historical_verdict": {"const": false}}}},
    "criticality_sensitivity": {"type": "array", "items": {"type": "object", "required": ["removed_facet", "baseline_size", "alternative_size", "alternative_classification"], "properties": {"removed_facet": {"type": "string"}, "baseline_size": {"type": ["integer", "null"]}, "alternative_size": {"type": ["integer", "null"]}, "alternative_classification": {"type": "string"}}}},
    "ancestor_terms": {"type": "array", "items": {"type": "object", "required": ["term", "source_paper_id", "first_observed", "evidence_ids"], "properties": {"term": {"type": "string"}, "source_paper_id": {"type": "string"}, "first_observed": {"type": "string", "format": "date"}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}}}},
    "residual_novelty": {"type": "string"},
    "defensible_rewrite": {"type": "object", "required": ["text", "prior_coverage_claims"], "properties": {"text": {"type": "string", "minLength": 1}, "prior_coverage_claims": {"type": "array", "items": {"type": "object", "required": ["text", "evidence_ids"], "properties": {"text": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}}}}}},
    "search": {
      "type": "object",
      "required": ["providers", "query_families", "query_runs", "failures", "gaps", "obligations", "bridge_policy", "coverage_derivation", "saturated"],
      "properties": {
        "providers": {"type": "array", "items": {"type": "object", "required": ["name", "status"]}},
        "query_families": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "query_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["query_id", "provider", "family", "query", "reason", "target_facets", "removed_author_terms", "retrieved_at", "temporal_recall_backstop", "provider_cutoff_applied", "returned_count", "total_count", "truncated", "pagination", "corpus", "saturation_stop_reason", "paper_ids", "canonical_paper_ids", "status"],
            "properties": {
              "temporal_recall_backstop": {"type": "boolean"},
              "provider_cutoff_applied": {"type": "boolean"},
              "returned_count": {"type": "integer", "minimum": 0},
              "total_count": {"type": ["integer", "null"], "minimum": 0},
              "truncated": {"type": "boolean"},
              "pagination": {"type": "object"},
              "corpus": {"type": "string", "minLength": 1},
              "saturation_stop_reason": {"enum": ["PROVIDER_EXHAUSTED", "NO_NEW_RESULTS", "PAGE_BUDGET_EXHAUSTED", "PROVIDER_ERROR"]},
              "paper_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "canonical_paper_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          }
        },
        "graph_expansions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["expansion_id", "status", "partial_reasons", "provider", "paper_ids", "cutoff", "temporal_recall_backstop", "provider_cutoff_applied", "limit_per_call", "anchor_selection", "calls", "failures", "bridge_candidate_ids", "historical_bridge_candidate_ids", "landscape_bridge_candidate_ids", "endpoint_reference_observations", "observation_window_days", "negative_result_scope", "discovered_paper_ids", "new_paper_ids"],
            "properties": {
              "expansion_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["COMPLETE", "PARTIAL"]},
              "partial_reasons": {"type": "array", "items": {"enum": ["PROVIDER_FAILURE", "LIMIT_REACHED"]}, "uniqueItems": true},
              "provider": {"enum": ["openalex", "semantic-scholar"]},
              "paper_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
              "cutoff": {"type": ["string", "null"], "format": "date"},
              "temporal_recall_backstop": {"type": "boolean"},
              "provider_cutoff_applied": {"type": "boolean"},
              "limit_per_call": {"type": "integer", "minimum": 1, "maximum": 1000},
              "anchor_selection": {"enum": ["LOWER_CITATION_COUNT", "CITATION_COUNT_INCOMPLETE_EXPAND_BOTH"]},
              "calls": {"type": "array", "items": {"type": "object", "required": ["direction", "anchor_paper_id", "returned_count", "limit", "possibly_truncated"], "properties": {"direction": {"enum": ["BACKWARD", "FORWARD"]}, "anchor_paper_id": {"type": "string"}, "returned_count": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 1000}, "possibly_truncated": {"type": "boolean"}}}},
              "failures": {"type": "array", "items": {"type": "object", "required": ["direction", "anchor_paper_id", "detail"]}},
              "bridge_candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "historical_bridge_candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "landscape_bridge_candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "endpoint_reference_observations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["paper_id", "provider_returned_count", "status"], "properties": {"paper_id": {"type": "string"}, "provider_returned_count": {"type": ["integer", "null"], "minimum": 0}, "status": {"enum": ["NONEMPTY", "EMPTY_AT_PROVIDER", "FAILED"]}}}},
              "observation_window_days": {"type": ["integer", "null"]},
              "negative_result_scope": {"enum": ["NO_HISTORICAL_CUTOFF", "INCOMPLETE_EXPANSION", "HISTORICAL_CANDIDATE_PRESENT", "NO_HISTORICAL_CANDIDATE_ENDPOINT_DATE_UNRESOLVED", "NO_HISTORICAL_CANDIDATE_POST_CUTOFF_ENDPOINT", "NO_HISTORICAL_CANDIDATE_PROVIDER_COVERAGE_LIMITED", "NO_HISTORICAL_CANDIDATE_WITHIN_COMPLETE_EXPANSION"]},
              "discovered_paper_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "new_paper_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          }
        },
        "failures": {"type": "array", "items": {"type": "object", "required": ["provider", "type", "detail"], "properties": {"provider": {"type": "string"}, "type": {"enum": ["RATE_LIMIT", "TIMEOUT", "HTTP_5XX", "MALFORMED_RESPONSE", "TRUNCATED", "AUTH", "OTHER"]}, "detail": {"type": "string"}}}},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "obligations": {"type": "array", "items": {"type": "object", "required": ["id", "status", "detail"], "properties": {"id": {"type": "string"}, "status": {"enum": ["COMPLETE", "INCOMPLETE"]}, "detail": {"type": "string"}}}},
        "bridge_policy": {"type": "object", "required": ["status", "high_citation_threshold", "source"], "properties": {"status": {"enum": ["CALIBRATED", "UNCONFIGURED"]}, "high_citation_threshold": {"type": ["integer", "null"], "minimum": 1}, "source": {"type": "string"}}},
        "coverage_derivation": {"type": "object", "required": ["level", "scope", "successful_providers", "successful_families", "reasons"], "properties": {"level": {"enum": ["BROAD", "MODERATE", "NARROW"]}, "scope": {"const": "PROTOCOL_EXECUTION_NOT_RECALL"}, "successful_providers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "successful_families": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "reasons": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "excluded": {
      "type": "object",
      "required": ["post_cutoff", "date_uncertain", "other"],
      "properties": {
        "post_cutoff": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "date_uncertain": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "other": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "audit_log": {"type": "array"}
  },
  "additionalProperties": true
}
