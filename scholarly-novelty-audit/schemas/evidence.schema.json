{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noveltyaudit.dev/schemas/v0.3.1/evidence.schema.json",
  "x-schema-version": "0.3.1",
  "title": "NoveltyAudit Evidence Span",
  "type": "object",
  "required": ["id", "canonical_paper_id", "source_level", "span", "location", "source", "retrieved_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "canonical_paper_id": {"type": "string", "minLength": 1},
    "source_level": {"enum": ["TIER_1_METADATA", "TIER_2_FULLTEXT", "GRAPH", "DATE"]},
    "span": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "acquisition_id": {"type": "string", "minLength": 1},
    "supports": {"type": "array", "items": {"type": "string"}},
    "evidence_kind": {"enum": ["METHOD", "RESULT", "ABSTRACT", "DATE", "CITATION_GRAPH", "BRIDGE_TEXT", "TERMINOLOGY", "OTHER"]}
  },
  "allOf": [
    {
      "if": {"properties": {"source_level": {"const": "TIER_2_FULLTEXT"}}, "required": ["source_level"]},
      "then": {"required": ["acquisition_id"]}
    }
  ],
  "additionalProperties": true
}
