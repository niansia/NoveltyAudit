{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noveltyaudit.dev/schemas/v0.3/claim.schema.json",
  "x-schema-version": "0.3.0",
  "title": "NoveltyAudit Claim Map",
  "type": "object",
  "required": ["claim_id", "claim_text", "frozen_before_retrieval", "frozen_at", "freeze_hash", "facets"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "claim_text": {"type": "string", "minLength": 1},
    "normalized_claim": {"type": "string"},
    "frozen_before_retrieval": {"const": true},
    "frozen_at": {"type": "string", "format": "date-time"},
    "freeze_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "facets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "text", "critical"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "type": {"enum": ["problem", "mechanism", "selection_principle", "representation", "constraint", "setting", "data_regime", "objective", "evaluation_condition", "interaction", "outcome", "other"]},
          "text": {"type": "string", "minLength": 1},
          "critical": {"type": "boolean"},
          "author_critical": {"type": ["boolean", "null"]},
          "structural_critical": {"type": ["boolean", "null"]},
          "criticality_dispute": {"type": "boolean"},
          "rationale": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
