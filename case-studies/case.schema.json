{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/niansia/NoveltyAudit/blob/main/case-studies/case.schema.json",
  "title": "NoveltyAudit public case study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "case_id",
    "case_type",
    "failure_mode",
    "evidence_status",
    "performance_status",
    "target",
    "author_bibliography",
    "prior_works",
    "audit_expectations",
    "provenance",
    "limitations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "case_type": {
      "enum": ["SYNTHETIC", "REVIEWER_GROUNDED", "PUBLIC_CASE_STUDY"]
    },
    "failure_mode": {
      "enum": [
        "MISSING_KILLER_PAPER",
        "COMPOSITION_ATTACK",
        "CLAIM_STRUCTURE_RESIDUAL_NOVELTY"
      ]
    },
    "evidence_status": {
      "enum": [
        "SYNTHETIC_CONTRACT_EXAMPLE",
        "REVIEWER_DERIVED",
        "CURATED_LITERATURE_HYPOTHESIS"
      ]
    },
    "performance_status": {
      "enum": ["CONTRACT_FIXTURE", "DIAGNOSTIC_ONLY", "NOT_RUN"]
    },
    "target": {"$ref": "#/$defs/paperTarget"},
    "author_bibliography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "prior_ids", "evidence_note"],
      "properties": {
        "status": {"enum": ["PROVIDED", "INSPECTED", "NOT_ASSESSED"]},
        "prior_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "evidence_note": {"type": "string", "minLength": 1}
      }
    },
    "prior_works": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/priorWork"}
    },
    "audit_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "named_prior_ids",
        "bibliography_absent_killer_ids",
        "candidate_mps_to_test",
        "bridge_source_ids",
        "facets",
        "residual_novelty_hypothesis",
        "expected_classification",
        "expected_behaviors"
      ],
      "properties": {
        "named_prior_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "bibliography_absent_killer_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "candidate_mps_to_test": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "bridge_source_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["facet_id", "description", "candidate_prior_ids", "status"],
            "properties": {
              "facet_id": {"type": "string"},
              "description": {"type": "string"},
              "candidate_prior_ids": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "status": {"type": "string"}
            }
          }
        },
        "residual_novelty_hypothesis": {"type": ["string", "null"]},
        "expected_classification": {
          "type": ["string", "null"],
          "enum": [
            "DIRECT_PRECEDENT",
            "STRONG_COMPOSITION_RISK",
            "PLAUSIBLE_COMPOSITION_RISK",
            "FRAGMENTED_PRECEDENT",
            "RESIDUAL_NOVELTY",
            "INCONCLUSIVE",
            null
          ]
        },
        "expected_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessed_on", "sources", "redistribution_note"],
      "properties": {
        "accessed_on": {"type": "string", "format": "date"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "redistribution_note": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "identifiers": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "urlList": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "uniqueItems": true
    },
    "paperTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "claim", "cutoff", "identifiers", "public_urls"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "cutoff": {"type": "string", "format": "date"},
        "identifiers": {"$ref": "#/$defs/identifiers"},
        "public_urls": {"$ref": "#/$defs/urlList"}
      }
    },
    "priorWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "title",
        "role",
        "earliest_public_date",
        "identifiers",
        "public_urls",
        "bibliography_status"
      ],
      "properties": {
        "paper_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "earliest_public_date": {"type": ["string", "null"], "format": "date"},
        "identifiers": {"$ref": "#/$defs/identifiers"},
        "public_urls": {"$ref": "#/$defs/urlList"},
        "bibliography_status": {
          "enum": ["IN_BIBLIOGRAPHY", "NOT_IN_BIBLIOGRAPHY", "NOT_ASSESSED"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "url", "license", "usage"],
      "properties": {
        "source_id": {"type": "string"},
        "title": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "license": {"type": "string"},
        "usage": {"type": "string"}
      }
    }
  }
}
